{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binggupack/schemas/collection_route_candidate.schema.json",
  "title": "CollectionRouteCandidate",
  "description": "BingguPack Layer2 자동수집 route 후보(insane-search 개념 차용·실행엔진 아님). route planning/method catalog/evidence provenance만. 실제 fetch/crawl/browser/ingest 0. collection_performed/ingest_performed const false.",
  "type": "object",
  "required": [
    "route_id", "route_phase", "method_family", "extraction_type",
    "auth_required", "execution_admission", "collection_performed",
    "ingest_performed", "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "route_id": {"type": "string"},
    "route_phase": {
      "type": "string",
      "enum": ["phase0_official_endpoint", "phase1_metadata", "phase2_public_route", "phase3_browser_required"],
      "description": "Phase 0 공식 endpoint/API/RSS → Phase3 browser_required(execution HOLD)"
    },
    "method_family": {
      "type": "string",
      "enum": ["official_api", "rss_atom", "ogp_jsonld_metadata", "mobile_json", "sitemap",
               "public_html_static", "search_then_extract", "browser_render"],
      "description": "No-Site-Name Rule: 특정 사이트명/selector/domain 하드코딩 금지·method_family 추상화"
    },
    "extraction_type": {
      "type": "string",
      "enum": ["structured_api", "feed", "metadata", "static_text", "rendered_dom"]
    },
    "auth_required": {
      "type": "string",
      "enum": ["none", "login_required", "paywall_required", "credential_required"],
      "description": "login/paywall/credential → automated execution HOLD/REJECT (terminal)"
    },
    "execution_admission": {
      "type": "string",
      "enum": ["ADMIT", "HOLD", "REJECT"],
      "description": "phase3 browser_required·auth_required는 HOLD/REJECT. 실제 실행은 별도 gate(현재 전역 HOLD)"
    },
    "source_url": {"type": ["string", "null"], "description": "임의 URL 허용(discovery freedom)"},
    "route_provenance": {
      "type": "object",
      "description": "route 출처 추적(어떤 method로 어디서 evidence 나오는지)",
      "additionalProperties": true
    },
    "collection_performed": {"const": false},
    "ingest_performed": {"const": false},
    "reason": {"type": "string"}
  }
}
